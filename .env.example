# =============================================
# HydraGateway – Master Environment Reference
# =============================================
# Copy this file to each service's .env and fill in real values.
# Never commit .env files to version control.

# ── Load Balancer ──────────────────────────
LB_PORT=8080
LB_HEALTH_INTERVAL_MS=10000

# ── Gateway ────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_INSTANCE_ID=gateway-1
# Downstream service URLs (used by gateway proxy + order-service)
AUTH_SERVICE_URL=http://localhost:4001
PRODUCT_SERVICE_URL=http://localhost:4002
PAYMENT_SERVICE_URL=http://localhost:4003
ORDER_SERVICE_URL=http://localhost:4004
# Health check polling interval (ms)
HEALTH_CHECK_INTERVAL_MS=10000
# Rate limiter behaviour on Redis failure: true=fail-open, false=fail-closed
RATE_LIMIT_FAIL_OPEN=true


# ── Auth Service ───────────────────────────
AUTH_PORT=4001
JWT_SECRET=API_GATEWAY_LOAD_BALANCER_Team_NitantJ_MokshaS_21_2006 
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ── Product Service ────────────────────────
PRODUCT_PORT=4002

# ── Payment Service ────────────────────────
PAYMENT_PORT=4003

# ── Order Service ──────────────────────────
ORDER_PORT=4004


# ── MongoDB ────────────────────────────────
# MONGO_URI=mongodb://localhost:27017/hydragateway
MONGO_URI=mongodb+srv://mokshasheth29_db_user:A9fXba64h3rKLOAu@cluster0.vydfppu.mongodb.net/hydragateway?retryWrites=true&w=majority&appName=Cluster0
MONGO_POOL_SIZE=10

# ── Redis ──────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Rate Limiting ──────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Cache ──────────────────────────────────
CACHE_TTL_SECONDS=60

# ── Internal Service Auth ──────────────────
INTERNAL_SECRET=API_GATEWAY_LOAD_BALANCER_Team_MokshaS_NitantJ__21_2006

# ── Logging ────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ── Node ───────────────────────────────────
NODE_ENV=development