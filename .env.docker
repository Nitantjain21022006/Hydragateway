# =============================================
# HydraGateway – Docker Environment Variables
# =============================================
# This file is used by docker-compose.yml.
# All "localhost" references have been replaced
# with Docker service names (Docker DNS resolves
# container-to-container by service name).
#
# MongoDB is NOT run inside Docker.
# It is hosted on MongoDB Atlas (external, cloud).
# MONGO_URI must be exported in your shell or set
# in a .env.docker.override file before running:
#   docker compose up --build
#
# DO NOT use this file for local development.
# Use .env for local dev (localhost refs intact).
# =============================================

# ── Load Balancer ──────────────────────────────────────────────────────────────
LB_PORT=8080
LB_HEALTH_INTERVAL_MS=15000
LB_HEALTH_TIMEOUT_MS=5000
HEALTH_FAILURE_THRESHOLD=2
HEALTH_SUCCESS_THRESHOLD=1

# ── Gateway Pool (targets for Load Balancer) ──────────────────────────────────
# Use Docker service names instead of localhost!
GW_INSTANCE_1_URL=http://gateway:3000
GW_INSTANCE_2_URL=http://gateway-2:3001

# ── Gateway ────────────────────────────────────────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_INSTANCE_ID=gateway-1
HEALTH_CHECK_INTERVAL_MS=15000
RATE_LIMIT_FAIL_OPEN=true

# ── Downstream service URLs (used by gateway proxy) ───────────────────────────
# Use Docker service names instead of localhost!
AUTH_SERVICE_URL=http://auth-service:4001
PRODUCT_SERVICE_URL=http://product-service:4002
PAYMENT_SERVICE_URL=http://payment-service:4003
ORDER_SERVICE_URL=http://order-service:4004

# ── Auth Service ───────────────────────────────────────────────────────────────
AUTH_PORT=4001
JWT_SECRET=API_GATEWAY_LOAD_BALANCER_Team_NitantJ_MokshaS_21_2006
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12

# ── Product Service ────────────────────────────────────────────────────────────
PRODUCT_PORT=4002

# ── Payment Service ────────────────────────────────────────────────────────────
PAYMENT_PORT=4003

# ── Order Service ──────────────────────────────────────────────────────────────
ORDER_PORT=4004

# ── MongoDB Atlas (external) ───────────────────────────────────────────────────
# MongoDB runs on MongoDB Atlas – NOT inside Docker.
# Replace the placeholder below with your real Atlas connection string,
# OR export MONGO_URI in your shell before running `docker compose up --build`.
# The value set here is ONLY a placeholder and will be overridden if MONGO_URI
# is already set in the host environment (docker-compose.yml uses ${MONGO_URI}).
MONGO_URI=mongodb+srv://mokshasheth29_db_user:A9fXba64h3rKLOAu@cluster0.vydfppu.mongodb.net/hydragateway?retryWrites=true&w=majority&appName=Cluster0
MONGO_POOL_SIZE=10

# ── Redis ──────────────────────────────────────────────────────────────────────
# Use Docker service name "redis" instead of localhost!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Cache ──────────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=60

# ── Analytics ─────────────────────────────────────────────────────────────────
ALLOW_ANALYTICS_RESET=true

# ── Internal Service Auth ──────────────────────────────────────────────────────
INTERNAL_SECRET=API_GATEWAY_LOAD_BALANCER_Team_MokshaS_NitantJ__21_2006

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/app/logs

# ── Node ───────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Circuit Breakers ──────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=10000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT_MS=5000
CIRCUIT_BREAKER_RETRY_ATTEMPTS=3
CIRCUIT_BREAKER_RETRY_DELAY_MS=1000

# ── Kafka (Phase 16) ──────────────────────────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=hydragateway
KAFKA_PRODUCER_RETRY_MAX=5
KAFKA_CONSUMER_RETRY_MAX=5
